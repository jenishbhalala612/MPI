{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/MPI_Frontend/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.netlify/functions/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
